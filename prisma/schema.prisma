generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  APPLICANT
  TRAINEE
  REGISTRAR
  FINANCE_OFFICER
  DEPARTMENT_HEAD
  ADMIN
  SYSTEM_AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REJECTED
  ELIGIBLE
  PLACED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum ProgramType {
  REGULAR
  EXTENSION
  SHORT_TERM
  DEGREE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  RE_ADMITTED
  INACTIVE
}

enum PaymentType {
  REGISTRATION_FEE
  STUDENT_ID
  REPLACEMENT_ID
  OTHER
}

enum DocumentType {
  APPLICATION_FORM
  GRADE_11_TRANSCRIPT
  GRADE_12_TRANSCRIPT
  ESLCE_CERTIFICATE
  GRADE_8_CERTIFICATE
  NATIONAL_ID
  PHOTO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  REGISTERED
  DROPPED
  COMPLETED
  CANCELLED
}

model Campus {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  programs  Program[]
  students  Student[]
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  phone        String      @unique
  passwordHash String
  role         UserRole    @default(APPLICANT)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  applicant    Applicant?
  student      Student?
  auditLogs    AuditLog[]
  verifiedDocs Document[]  @relation("VerifiedDocuments")
  applications Application[]
}

model Applicant {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  gender      Gender
  dob         DateTime
  address     String?
  specialNeeds String?
  admissionId String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  applications Application[]
}

model Application {
  id             String            @id @default(uuid())
  applicantId    String
  applicant      Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  programType    ProgramType
  preferences    Json
  eslceScore     Float?
  status         ApplicationStatus @default(DRAFT)
  notes          String?
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  documents      Document[]
  user           User?             @relation(fields: [userId], references: [id])
  userId         String?
}

model Document {
  id           String      @id @default(uuid())
  applicationId String
  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileUrl      String
  verified     Boolean     @default(false)
  verifiedById String?
  verifiedBy   User?       @relation("VerifiedDocuments", fields: [verifiedById], references: [id])
  uploadedAt   DateTime    @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
  programs  Program[]
}

model Program {
  id          String      @id @default(uuid())
  name        String
  type        ProgramType
  level       String
  duration    Int
  capacity    Int
  cutOffScore Float
  campusId    String
  campus      Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  students    Student[]
}

model Course {
  id           String      @id @default(uuid())
  code         String      @unique
  title        String
  creditHours  Int
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  enrollments  Enrollment[]
  attendance   Attendance[]
}

model Student {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationNo String      @unique
  programId      String
  program        Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  campusId       String
  campus         Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  level          String
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  payments       Payment[]
  enrollments    Enrollment[]
  attendance     Attendance[]
}

model Enrollment {
  id        String          @id @default(uuid())
  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester  String
  status    EnrollmentStatus @default(REGISTERED)
  grade     Float?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([studentId, courseId, semester])
}

model Payment {
  id         String      @id @default(uuid())
  studentId  String
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount     Float
  type       PaymentType
  receiptNo  String      @unique
  date       DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Attendance {
  id        String          @id @default(uuid())
  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([studentId, courseId, date])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  timestamp DateTime @default(now())
  details   Json?
}

model AcademicPolicy {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
